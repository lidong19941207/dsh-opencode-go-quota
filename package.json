{
  "name": "dsh-opencode-go-quota",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：在侧边栏实时显示 OpenCode Go 的 5 小时 / 周 / 月额度",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "quota",
    "usage",
    "sidebar"
  ],
  "license": "MIT",
  "author": "lidong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidong19941207/dsh-opencode-go-quota.git"
  },
  "bugs": {
    "url": "https://github.com/lidong19941207/dsh-opencode-go-quota/issues"
  },
  "homepage": "https://github.com/lidong19941207/dsh-opencode-go-quota#readme",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/client.test.mjs && node test/host.test.mjs",
    "test:client": "node test/client.test.mjs",
    "test:host": "node test/host.test.mjs"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
